# Sharely Railway template — runtime env vars (read by app.js + src/config/*).
# Source-of-truth for the sharely service template-vars.json defaultValues;
# edit both together. The `mongo` service has its own .env in ./mongo/.

# --- App ---
PORT=3000
TZ=UTC
NODE_ENV=production
UPLOAD_DIR=/app/uploads
BASE_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# --- Session (required; auto-generated on deploy) ---
SESSION_SECRET=${{secret(64)}}

# --- MongoDB companion (resolved by companion-mapping.json) ---
# Wired to the `mongo` service's private domain on the Railway network.
MONGODB_URI=mongodb://${{mongo.MONGO_APP_USER}}:${{mongo.MONGO_APP_PASSWORD}}@${{mongo.MONGO_PRIVATE_DOMAIN}}:27017/${{mongo.MONGO_DB_NAME}}?authSource=admin

# --- Optional ---
# Set to 'false' to disable public registration (admin must create users).
ALLOW_REGISTRATION=true
# Max upload size in MB (default 100).
MAX_FILE_SIZE_MB=100
